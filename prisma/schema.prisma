generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Question {
  id                 Int      @id @default(autoincrement())
  key                String   @unique
  phase              Int      // 1, 2, or 3
  group              String   // "TREATMENT", "CONTROL", or "ALL"
  text               String
  options            String   // JSON array of strings e.g. '["A","B","C"]'
  correctOptionIndex Int
  reason             String   @default("")
  isTrapped          Boolean  @default(false)
  isBet              Boolean  @default(false)
  sortOrder          Int      @default(0) // ordering within phase+group
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Participant {
  id        String     @id @default(cuid())
  group     String     // "TREATMENT" or "CONTROL"
  createdAt DateTime   @default(now())
  responses Response[]
}

model Response {
  id                  Int         @id @default(autoincrement())
  participantId       String
  participant         Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  questionKey         String
  phase               Int
  selectedOption      Int
  isSuggestedAnswer   Boolean
  openedReason        Boolean
  timeToAnswerSeconds Float
  isTrapped           Boolean     @default(false)
  createdAt           DateTime    @default(now())

  @@unique([participantId, questionKey])
}
